---
import workflow from '../../data/workflow.json';

const stages = workflow;
const sourceUrl = (path: string) => `https://github.com/gwpicard/ai-build-kit/blob/stable/${path}`;
---

<section class="workflow" aria-label="Workflow stages">
  <div class="diagram">
    <div class="loop" aria-hidden="true">
      <svg viewBox="0 0 1000 700" preserveAspectRatio="none">
        <defs>
          <marker id="loop-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
            <path d="M0,0 L8,4 L0,8 Z" />
          </marker>
        </defs>
        <path d="M500 120 C620 120 720 120 833 120" />
        <path d="M833 120 C870 190 870 280 833 350" />
        <path d="M833 350 C870 430 870 500 833 580" />
        <path d="M833 580 C730 630 605 630 500 580" />
        <path d="M500 580 C395 630 270 630 167 580" />
        <path d="M167 580 C130 500 130 430 167 350" />
        <path d="M167 350 C130 200 350 120 500 120" />
      </svg>
    </div>

    <ol class="stage-ring">
      {stages.map((stage, index) => {
        const expanded = index === 0;
        const panelId = `workflow-panel-${stage.id}`;
        return (
          <li class="stage" data-position={index + 1}>
            <button
              class="stage-button"
              id={`workflow-button-${stage.id}`}
              type="button"
              aria-expanded={expanded ? 'true' : 'false'}
              aria-controls={panelId}
              data-stage-button
            >
              <span class="stage-name">{stage.title}</span>
              {stage.command && <code>{stage.command}</code>}
            </button>
          </li>
        );
      })}
    </ol>
  </div>

  <div class="panels">
    {stages.map((stage, index) => {
      const expanded = index === 0;
      const panelId = `workflow-panel-${stage.id}`;
      return (
        <section
          class="stage-panel"
          id={panelId}
          role="region"
          aria-labelledby={`workflow-heading-${stage.id}`}
          hidden={!expanded}
          data-stage-panel
        >
          <h2 id={`workflow-heading-${stage.id}`}>{stage.title}</h2>
          <p class="stage-summary">{stage.summary}</p>
          <div class="detail decision">
            <h3>What you decide</h3>
            <p>{stage.person_decides}</p>
          </div>
          {stage.checks_anchor && (
            <p class="checks-link"><a href={`#${stage.checks_anchor}`}>Jump to what is checked at this step</a></p>
          )}
          <details class="technical-details">
            <summary>Checks and source details</summary>
            {stage.command && (
              <div class="detail">
                <h3>Command</h3>
                <code>{stage.command}</code>
              </div>
            )}
            <div class="detail">
              <h3>Background skills</h3>
              <ul class="skill-list">
                {stage.skills.map((skill) => <li><code>{skill}</code></li>)}
              </ul>
            </div>
            {stage.checks.length > 0 && (
              <div class="detail">
                <h3>Checks</h3>
                {stage.checks.map((check) => (
                  <div class="check">
                    <p><code>{check.script}</code>: {check.description}</p>
                  </div>
                ))}
              </div>
            )}
            <a class="source-link" href={sourceUrl(stage.source)}>Source skill (for maintainers)</a>
          </details>
        </section>
      );
    })}
  </div>

  <section class="stage-text" aria-labelledby="stage-list-heading">
    <h2 id="stage-list-heading">Stages in order</h2>
    <ol>
      {stages.map((stage) => <li>{stage.title}</li>)}
    </ol>
  </section>
</section>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-stage-button]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-stage-panel]'));

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const opening = button.getAttribute('aria-expanded') !== 'true';

      buttons.forEach((item) => item.setAttribute('aria-expanded', 'false'));
      panels.forEach((panel) => { panel.hidden = true; });

      if (opening) {
        button.setAttribute('aria-expanded', 'true');
        const panel = document.getElementById(button.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = false;
      }
    });
  });
</script>

<style>
  .workflow {
    --workflow-line: var(--sl-color-gray-5);
    --workflow-active: var(--sl-color-accent);
    --workflow-active-bg: var(--sl-color-accent-low);
    color: var(--sl-color-text);
  }

  .diagram { position: relative; }

  .loop {
    position: absolute;
    inset: 0;
    width: 100%;
    pointer-events: none;
  }

  .loop svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .loop path {
    fill: none;
    stroke: var(--workflow-line);
    stroke-width: 3;
    marker-end: url(#loop-arrow);
  }

  .loop marker path {
    fill: var(--workflow-line);
    stroke: none;
  }

  .stage-ring {
    position: relative;
    display: grid;
    grid-template: repeat(3, minmax(8rem, 1fr)) / repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: center;
    min-height: 40rem;
    margin: 0;
    padding: 1rem 0;
    list-style: none;
  }

  .stage {
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .stage[data-position='1'] { grid-area: 1 / 2; }
  .stage[data-position='2'] { grid-area: 1 / 3; }
  .stage[data-position='3'] { grid-area: 2 / 3; }
  .stage[data-position='4'] { grid-area: 3 / 3; }
  .stage[data-position='5'] { grid-area: 3 / 2; }
  .stage[data-position='6'] { grid-area: 3 / 1; }
  .stage[data-position='7'] { grid-area: 2 / 1; }

  .stage-button {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    justify-content: center;
    min-width: 9rem;
    max-width: 14rem;
    min-height: 5rem;
    padding: 0.75rem 1rem;
    border: 2px solid var(--workflow-line);
    border-radius: 0.35rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    text-align: center;
    cursor: pointer;
  }

  .stage-button:hover,
  .stage-button[aria-expanded='true'] {
    border-color: var(--workflow-active);
    background: var(--workflow-active-bg);
  }

  .stage-button:focus-visible,
  .source-link:focus-visible {
    outline: 3px solid var(--workflow-active);
    outline-offset: 3px;
  }

  .stage-name { font-weight: 650; }
  .stage-button code { font-size: 0.8rem; }

  .stage-panel {
    margin-top: 1.5rem;
    padding: 1.5rem;
    border: 1px solid var(--workflow-line);
    border-radius: 0.35rem;
    background: var(--sl-color-bg-nav);
  }

  .stage-panel h2 { margin-top: 0; }
  .stage-summary { margin: 0.75rem 0 0; }
  .technical-details { margin-top: 1.25rem; }
  .technical-details > summary { cursor: pointer; font-weight: 650; }
  .detail { margin-top: 1.25rem; }
  .detail h3 { margin-bottom: 0.4rem; font-size: 1rem; }
  .detail p { margin: 0; }
  .checks-link { margin: 1rem 0 0; }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-list li code {
    display: inline-block;
    padding: 0.25rem 0.45rem;
    border: 1px solid var(--workflow-line);
    border-radius: 0.2rem;
  }

  .check + .check { margin-top: 1rem; }
  .check p { margin-bottom: 0.5rem; }
  .check dl { margin: 0; }

  .exit-meaning {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 0.5rem;
    padding: 0.4rem 0;
    border-top: 1px solid var(--workflow-line);
  }

  .exit-meaning dt { font-weight: 650; }
  .exit-meaning dd { margin: 0; }
  .decision { padding-top: 1rem; border-top: 1px solid var(--workflow-line); }
  .source-link { display: inline-block; margin-top: 1.25rem; }

  .stage-text { margin-top: 2rem; }
  .stage-text h2 { font-size: 1.25rem; }

  @media (max-width: 650px) {
    .loop { display: none; }

    .stage-ring {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
      min-height: 0;
      padding: 0;
    }

    .stage,
    .stage[data-position] {
      grid-area: auto;
      justify-content: stretch;
    }

    .stage-button {
      width: 100%;
      max-width: none;
      text-align: left;
    }

    .stage-panel { padding: 1rem; }
    .exit-meaning { grid-template-columns: 5rem minmax(0, 1fr); }
  }
</style>
