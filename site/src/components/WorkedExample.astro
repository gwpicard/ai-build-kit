---
import Terminal from './Terminal.astro';
import workflow from '../../data/workflow.json';
import story from '../../data/example/story.json';
import founding from '../../data/example/founding.json';
import shape from '../../data/example/shape.json';
import unprovenFact from '../../data/example/unproven-fact.json';
import readyPiece from '../../data/example/ready-piece.json';
import moreMidBuild from '../../data/example/more-mid-build.json';
import mergeLive from '../../data/example/merge-live.json';
import liveCopy from '../../data/example/live-copy.json';
import maintain from '../../data/example/maintain.json';
import returnAfterStop from '../../data/example/return-after-stop.json';

const recordings = {
  founding,
  shape,
  'unproven-fact': unprovenFact,
  'ready-piece': readyPiece,
  'more-mid-build': moreMidBuild,
  'merge-live': mergeLive,
  'live-copy': liveCopy,
  maintain,
  'return-after-stop': returnAfterStop,
};
const stageFor = (id: string) => workflow.find((stage) => stage.id === id);
const sourceUrl = (path: string) => `https://github.com/gwpicard/ai-build-kit/blob/stable/${path}`;
const gradeLabel = (grade: { hit: number; drift: number; miss: number; unobservable: number }) =>
  `${grade.hit} hit, ${grade.drift} drift, ${grade.miss} miss`;
---

<div class="story-list">
  {story.map((step, index) => {
    const run = recordings[step.file];
    const stage = stageFor(run.workflowStage);
    return (
      <section class="story-step" aria-labelledby={`step-${index}`}>
        <div class="step-copy">
          <p class="step-number">Step {String(index + 1).padStart(2, '0')}</p>
          <h2 id={`step-${index}`}>{step.title}</h2>
          <p>{step.happened}</p>
          <p class="person-choice"><strong>Your decision:</strong> {step.decision}</p>

          <details class="workflow-facts">
            <summary>Run details and checks</summary>
            <p class="replay-note">Recorded test conversation. Kit version 1.0.</p>
            <p class="grade-note">Grade: {gradeLabel(run.grade)}{run.grade.unobservable ? `, ${run.grade.unobservable} not observable` : ''}.</p>
            {stage && <>
              <h3>Workflow stage: {stage.title}</h3>
              <p class="fact-label">Skills in this stage</p>
              <ul class="skill-list">
                {run.skills.map((skill) => <li><a href={sourceUrl(`.agents/skills/${skill}/SKILL.md`)}>{skill}</a></li>)}
              </ul>
              <p class="fact-label">Checks listed in this run record</p>
              {run.checks.length ? (
                <ul class="check-list">
                  {run.checks.map((check) => (
                    <li>
                      <code>{check.script}</code>
                      <ul>
                        {Object.entries(check.exits).map(([code, meaning]) => <li><code>{code}</code>: {meaning}</li>)}
                      </ul>
                    </li>
                  ))}
                </ul>
              ) : <p>The run record lists no script check for this step.</p>}
            </>}
          </details>
        </div>
        <div class="step-terminal">
          <Terminal id={`terminal-${step.file}`} label={`${run.replayCase} recorded conversation`} turns={run.turns} />
        </div>
      </section>
    );
  })}
</div>

<style>
  .story-list { display: grid; gap: 2rem; margin-top: 2rem; }
  .story-step { display: grid; grid-template-columns: minmax(16rem, 0.78fr) minmax(0, 1.22fr); gap: 1.5rem; padding: 1.5rem 0 2rem; border-top: 1px solid var(--sl-color-gray-5); }
  .step-copy h2 { margin: 0.25rem 0 0.75rem; font-size: 1.45rem; }
  .step-number { margin: 0; color: var(--sl-color-green-high); font: 700 0.75rem/1.2 var(--sl-font-system-mono); letter-spacing: 0.09em; }
  .replay-note, .grade-note { margin: 0.25rem 0; color: var(--sl-color-gray-2); font-size: 0.82rem; }
  .workflow-facts { margin-top: 1.25rem; padding: 1rem; border-left: 3px solid var(--sl-color-green); background: var(--sl-color-bg-nav); }
  .workflow-facts > summary { cursor: pointer; font-weight: 650; }
  .workflow-facts h3 { margin: 0.75rem 0; font-size: 0.95rem; }
  .fact-label { margin: 0.75rem 0 0.25rem; font-size: 0.77rem; font-weight: 700; }
  .skill-list { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; list-style: none; }
  .skill-list li { padding: 0.25rem 0.5rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.2rem; font: 0.72rem/1.5 var(--sl-font-system-mono); }
  .check-list { margin: 0; padding-left: 1rem; font-size: 0.8rem; }
  .check-list ul { margin: 0.25rem 0; padding-left: 1rem; }
  .check-list li { margin: 0.25rem 0; }
  .check-list code { overflow-wrap: anywhere; }
  .person-choice { margin: 1rem 0 0; padding-top: 0.75rem; border-top: 1px solid var(--sl-color-gray-5); font-size: 0.83rem; }
  @media (max-width: 860px) { .story-step { grid-template-columns: 1fr; gap: 0.25rem; } }
</style>
