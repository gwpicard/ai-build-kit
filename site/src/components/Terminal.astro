---
interface Turn {
  who: 'person' | 'kit';
  text: string;
}

interface Props {
  id: string;
  label: string;
  turns: Turn[];
}

const { id, label, turns } = Astro.props;
---

<section class="terminal" data-terminal id={id} aria-label={label}>
  <header class="terminal-head">
    <span class="terminal-mark" aria-hidden="true">●</span>
    <span>{label}</span>
    <span class="terminal-count">{turns.length} turns</span>
  </header>
  <div class="terminal-controls" data-controls hidden>
    <button type="button" data-play>Play turns</button>
    <button type="button" data-pause disabled>Pause turns</button>
    <button type="button" data-show-all>Show all turns</button>
    <span class="sr-only" data-status aria-live="polite"></span>
  </div>
  <div class="terminal-output" data-output role="log" aria-label={`${label} transcript`}>
    {turns.map((turn, index) => (
      <article class:list={['turn', `turn-${turn.who}`]} data-turn data-index={index}>
        <h3>{turn.who === 'person' ? 'Person' : 'Kit'}</h3>
        <pre>{turn.text}</pre>
      </article>
    ))}
  </div>
</section>

<script>
  const terminals = document.querySelectorAll<HTMLElement>('[data-terminal]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reducedMotion) {
    terminals.forEach((terminal) => {
      const turns = Array.from(terminal.querySelectorAll<HTMLElement>('[data-turn]'));
      const controls = terminal.querySelector<HTMLElement>('[data-controls]');
      const play = terminal.querySelector<HTMLButtonElement>('[data-play]');
      const pause = terminal.querySelector<HTMLButtonElement>('[data-pause]');
      const showAll = terminal.querySelector<HTMLButtonElement>('[data-show-all]');
      const status = terminal.querySelector<HTMLElement>('[data-status]');
      if (!controls || !play || !pause || !showAll || !status || turns.length < 2) return;

      let shown = 1;
      let timer: number | undefined;
      const update = () => {
        turns.forEach((turn, index) => { turn.hidden = index >= shown; });
        status.textContent = `Showing ${shown} of ${turns.length} turns.`;
        pause.disabled = timer === undefined;
        play.disabled = shown >= turns.length;
      };
      const stop = () => {
        if (timer !== undefined) window.clearInterval(timer);
        timer = undefined;
        update();
      };

      turns.forEach((turn, index) => { turn.hidden = index > 0; });
      controls.hidden = false;
      update();
      play.addEventListener('click', () => {
        if (timer !== undefined || shown >= turns.length) return;
        timer = window.setInterval(() => {
          shown += 1;
          update();
          if (shown >= turns.length) stop();
        }, 1200);
        update();
      });
      pause.addEventListener('click', stop);
      showAll.addEventListener('click', () => {
        stop();
        shown = turns.length;
        update();
      });
    });
  }
</script>

<style>
  .terminal {
    overflow: hidden;
    margin: 1.5rem 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.55rem;
    background: #101b19;
    color: #eff5eb;
    box-shadow: 0 12px 30px #101b191c;
  }

  .terminal-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 2.8rem;
    padding: 0 1rem;
    border-bottom: 1px solid #ffffff20;
    color: #d3dfd3;
    font: 600 0.78rem/1.2 var(--sl-font-system-mono);
  }

  .terminal-mark { color: #b9cf83; font-size: 0.72rem; }
  .terminal-count { margin-left: auto; color: #98aaa0; font-weight: 400; }
  .terminal-controls { display: flex; gap: 0.5rem; padding: 0.75rem 1rem 0; }
  .terminal-controls[hidden] { display: none; }

  .terminal-controls button {
    padding: 0.5rem 0.75rem;
    border: 1px solid #65766d;
    border-radius: 0.25rem;
    background: transparent;
    color: #f0f4eb;
    font: 600 0.75rem/1.2 var(--sl-font-system);
    cursor: pointer;
  }

  .terminal-controls button:hover:not(:disabled) { background: #ffffff16; }
  .terminal-controls button:focus-visible { outline: 2px solid #d3e58e; outline-offset: 2px; }
  .terminal-controls button:disabled { opacity: 0.45; cursor: default; }
  .terminal-output { max-height: 29rem; overflow: auto; padding: 0.7rem 1rem 1rem; }
  .turn { padding: 0.75rem 0; border-bottom: 1px solid #ffffff18; }
  .turn:last-child { border-bottom: 0; }
  .turn h3 { margin: 0 0 0.5rem; font: 700 0.72rem/1.2 var(--sl-font-system-mono); letter-spacing: 0.08em; }
  .turn-person h3 { color: #f2c875; }
  .turn-kit h3 { color: #a8ce9a; }
  .turn pre { margin: 0; color: #e5ece5; white-space: pre-wrap; overflow-wrap: anywhere; font: 0.78rem/1.65 var(--sl-font-system-mono); }
  .turn[hidden] { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (max-width: 520px) {
    .terminal-output { max-height: 24rem; padding-inline: 0.75rem; }
    .terminal-controls { flex-wrap: wrap; }
  }
</style>
