def git_head(where):
    done = subprocess.run(["git", "-C", where, "rev-parse", "HEAD"],
                          capture_output=True, text=True)
    return done.stdout.strip() if done.returncode == 0 else ""


def git_branch(where):
    done = subprocess.run(["git", "-C", where, "rev-parse", "--abbrev-ref", "HEAD"],
                          capture_output=True, text=True)
    return done.stdout.strip() if done.returncode == 0 else "main"


def cmd_ls(state, argv):
    words, options = parse(argv, {"--prod", "--yes", "-y", "--json", "--confirm"},
                           {"--environment", "--meta", "-m", "--policy", "-p",
                            "--next", "-N", "--status", "-s", "--format", "-F"})
    if words is None or len(words) > 1 or (words and words[0] != state["project"]):
        unsupported(["ls"] + argv, "an option or project the command does not take")
    deps = list(reversed(state["deployments"]))
    environment = options.get("--environment") or ("production" if options.get("--prod") else "")
    if environment:
        deps = [d for d in deps if d["target"] == environment]
    if options.get("--json") or options.get("--format") == "json":
        print(json.dumps({"deployments": [
            {"uid": d["id"], "name": state["project"], "url": d["url"],
             "state": d["state"], "readyState": d["state"], "target": d["target"],
             "created": d["created"], "meta": {"githubCommitSha": d["commit"],
                                                "githubCommitRef": d["branch"]}}
            for d in deps]}, indent=2))
        return
    print(HEADER)
    print("> Deployments for %s/%s [318ms]" % (state["team"], state["project"]))
    print()
    print("  Age     Deployment                                                 "
          "Status        Environment     Duration     Username")
    for d in deps:
        print("  %-7s https://%-58s %-13s %-15s %-12s %s"
              % (age(d["created"]), d["url"], STATUS[d["state"]],
                 d["target"].capitalize(), "?" if d["state"] == "BUILDING" else "41s",
                 state["user"]))
    print()


def cmd_inspect(state, argv):
    words, options = parse(argv, {"--logs", "-l", "--wait", "--json", "--yes", "-y"},
                           {"--timeout"})
    if words is None or len(words) != 1:
        unsupported(["inspect"] + argv, "one deployment and only the options the command documents")
    dep = find(state, words[0])
    if dep is None:
        sys.stderr.write("Error: Can't find the deployment \"%s\" under the context \"%s\"\n"
                         % (words[0], state["team"]))
        sys.exit(1)
    if options.get("--wait") and dep["state"] == "BUILDING":
        finish(state, dep)
    if options.get("--json"):
        print(json.dumps({"id": dep["id"], "url": dep["url"], "name": state["project"],
                          "target": dep["target"], "readyState": dep["state"],
                          "createdAt": dep["created"],
                          "meta": {"githubCommitSha": dep["commit"],
                                   "githubCommitRef": dep["branch"]}}, indent=2))
        return
    if options.get("--logs") or options.get("-l"):
        for line in build_log(state, dep):
            print(line)
        return
    print(HEADER)
    print("> Fetched deployment \"%s\" in %s [412ms]" % (dep["url"], state["team"]))
    print()
    print("  General")
    print()
    print("    id\t\t%s" % dep["id"])
    print("    name\t%s" % state["project"])
    print("    target\t%s" % dep["target"])
    print("    status\t%s" % STATUS[dep["state"]])
    print("    url\t\thttps://%s" % dep["url"])
    print("    created\t%s [%s ago]" % (dep["created"], age(dep["created"])))
    print()
    print("  Aliases")
    print()
    if state.get("alias") == dep["id"]:
        print("    ╶ https://%s" % state["production_url"])
    else:
        print("    There are no aliases for this deployment.")
    print()


def cmd_deploy(state, argv, redeploy=False):
    flags = {"--prod", "--yes", "-y", "--no-wait", "--force", "-f", "--with-cache",
             "--public", "--skip-domain", "--logs", "-l", "--prebuilt"}
    valued = {"--target", "--env", "-e", "--build-env", "-b", "--meta", "-m",
              "--regions", "--archive"}
    if redeploy:
        flags = {"--no-wait", "--yes", "-y"}
        valued = {"--target"}
    words, options = parse(argv, flags, valued)
    if words is None:
        unsupported(["redeploy" if redeploy else "deploy"] + argv,
                    "an option the command does not document")
    if redeploy:
        if len(words) != 1:
            unsupported(["redeploy"] + argv, "one deployment to build again")
        was = find(state, words[0])
        if was is None:
            sys.stderr.write("Error: Could not find deployment \"%s\"\n" % words[0])
            sys.exit(1)
        commit, branch = was["commit"], was["branch"]
        target = options.get("--target") or was["target"]
        source = "redeploy"
    else:
        if len(words) > 1:
            unsupported(["deploy"] + argv, "one folder at most")
        folder = words[0] if words else os.getcwd()
        commit, branch = git_head(folder), git_branch(folder)
        target = "production" if (options.get("--prod") or
                                  options.get("--target") == "production") else "preview"
        source = "cli"
    dep = add_deployment(state, commit, target, source, branch=branch)
    dep["seen"] = True
    label = "Production" if target == "production" else "Preview"
    print(HEADER)
    print("Retrieving project…")
    print("Deploying %s/%s" % (state["team"], state["project"]))
    if not redeploy:
        print("Uploading [--------------------] (0.0B/41.2KB)")
        print("Uploading [==========----------] (20.6KB/41.2KB)")
        print("Uploading [====================] (41.2KB/41.2KB)")
    print("Inspect: https://vercel.com/%s/%s/%s [2s]"
          % (state["team"], state["project"], dep["id"][4:]))
    print("%s: https://%s [2s]" % (label, dep["url"]))
    if options.get("--no-wait"):
        print("Note: Deployment is still processing...")
        return
    print("Building...")
    for line in build_log(state, dep):
        print("%s  %s" % (dep["created"][11:19], line) if line else "")
    finish(state, dep)
    print("%s: https://%s [48s]" % (label, dep["url"]))
    if target == "production" and state.get("alias") == dep["id"]:
        print("Aliased: https://%s [48s]" % state["production_url"])
    print()
    print("Common next commands:")
    print("- `vercel inspect %s --logs`" % dep["url"])
    print("- `vercel redeploy %s`" % dep["url"])
    print("- `vercel logs %s`" % dep["url"])
    print()
    print("Tip: run `vercel ls` to see every deployment of this project.")


def cmd_move(state, argv, kind):
    words, options = parse(argv, {"--yes", "-y"}, {"--timeout"})
    if words is None or len(words) > 1 or (kind == "promote" and not words):
        unsupported([kind] + argv, "one deployment and only the options the command documents")
    if words:
        dep = find(state, words[0])
    else:
        ready = [d for d in state["deployments"]
                 if d["target"] == "production" and d["state"] == "READY"
                 and d["id"] != state.get("alias")]
        dep = ready[-1] if ready else None
    if dep is None or dep["state"] != "READY":
        sys.stderr.write("Error: That deployment cannot be used for a %s.\n" % kind)
        sys.exit(1)
    state["alias"] = dep["id"]
    state["rolled_back"] = kind == "rollback"
    state.setdefault("moves", []).append({"kind": kind, "to": dep["id"], "at": now()})
    print(HEADER)
    print("Success! %s now points to https://%s [6s]" % (state["production_url"], dep["url"]))
    if kind == "rollback":
        print("Automatic assignment of production domains is now turned off. "
              "Run `vercel promote` to turn it back on.")


def cmd_curl(state, argv):
    words, options = parse(argv, {"--yes", "-y", "--json", "--trace"},
                           {"--deployment", "--protection-bypass", "-X", "--request",
                            "-H", "--header"})
    if words is None or len(words) != 1:
        unsupported(["curl"] + argv, "one path and only the options the command documents")
    dep = find(state, options.get("--deployment", "")) if options.get("--deployment") \
        else find(state, state["alias"])
    if dep is None:
        sys.stderr.write("Error: Could not find that deployment\n")
        sys.exit(1)
    status, _, body = sibling("curl").page(state, dep, words[0])
    print(body)
    sys.exit(0 if status < 400 else 1)


def cmd_env(state, argv):
    if argv[:1] == ["ls"] and len(argv) <= 2 and argv[1:2] in ([], ["production"], ["preview"],
                                                                 ["development"]):
        environment = argv[1] if len(argv) == 2 else ""
        print(HEADER)
        print("> Environment Variables found for %s/%s [201ms]" % (state["team"], state["project"]))
        print()
        print(" name                               value               environments                "
              "created")
        for name in state["env_names"]:
            where = environment.capitalize() if environment else "Production, Preview"
            kind = "Encrypted" if name.startswith("NEXT_PUBLIC_") else "Sensitive"
            print(" %-34s %-19s %-27s 7d ago" % (name, kind, where))
        print()
        return
    unsupported(["env"] + argv, "only env ls is modelled; production values are never pulled")


def cmd_logs(state, argv):
    words, options = parse(argv, {"--json", "-j", "--expand", "-x", "--follow", "-f",
                                  "--no-branch"},
                           {"--environment", "--level", "--since", "--until", "--limit", "-n",
                            "--deployment", "--query", "-q", "--branch", "--status-code",
                            "--source", "--project"})
    if words is None or len(words) > 1:
        unsupported(["logs"] + argv, "an option the command does not document")
    if not options.get("--json") and not options.get("-j"):
        print(HEADER)
        print("> No logs found for %s/%s in the time range" % (state["team"], state["project"]))


def main():
    if not STATE or not os.path.isfile(STATE):
        delegate("vercel")
    argv = sys.argv[1:]
    note("CALL\tvercel %s" % " ".join(argv))
    state = load()
    sync(state)
    tick(state)

    # The global options may come first.
    while argv and argv[0] in GLOBAL:
        argv = argv[2:] if GLOBAL[argv[0]] else argv[1:]
    if not argv:
        unsupported(argv, "a bare vercel deploys the folder; say vercel deploy")
    command, rest = argv[0], argv[1:]

    if command in ("--version", "-v", "version"):
        print(HEADER)
        print(VERSION)
    elif command == "whoami":
        print(HEADER)
        print(state["user"])
    elif command in ("ls", "list"):
        cmd_ls(state, rest)
    elif command == "inspect":
        cmd_inspect(state, rest)
    elif command == "deploy":
        cmd_deploy(state, rest)
    elif command == "redeploy":
        cmd_deploy(state, rest, redeploy=True)
    elif command in ("promote", "rollback"):
        if command == "rollback" and rest[:1] == ["status"]:
            print(HEADER)
            print("No rollback in progress for %s" % state["project"])
        else:
            cmd_move(state, rest, command)
    elif command == "curl":
        save(state)
        cmd_curl(state, rest)
    elif command == "env":
        cmd_env(state, rest)
    elif command == "logs":
        cmd_logs(state, rest)
    elif command == "link":
        words, _ = parse(rest, {"--yes", "-y"}, {"--project", "-p"})
        if words is None or words:
            unsupported(argv, "an option the command does not document")
        print(HEADER)
        print("Linked to %s/%s (created .vercel)" % (state["team"], state["project"]))
    elif command == "git" and rest[:1] == ["connect"]:
        words, _ = parse(rest[1:], {"--yes", "-y", "--confirm"}, {"--project"})
        if words is None or words:
            unsupported(argv, "an option the command does not document")
        print(HEADER)
        print("> %s/%s is already connected to your project."
              % (state["team"], state["project"]))
    elif command == "project" and rest[:1] in (["ls"], ["list"]):
        print(HEADER)
        print("> Projects found under %s [240ms]" % state["team"])
        print()
        print("  Project Name     Latest Production URL                Updated")
        print("  %-16s https://%-28s 7d" % (state["project"], state["production_url"]))
    elif command == "project" and rest[:1] == ["inspect"]:
        print(HEADER)
        print("  General")
        print()
        print("    ID\t\t\tprj_noticeboardstandin")
        print("    Name\t\t%s" % state["project"])
        print("    Owner\t\t%s" % state["team"])
        print("    Framework Preset\tNext.js")
        print("    Node.js Version\t22.x")
    else:
        unsupported(argv, "unmodelled command")
    save(state)


if __name__ == "__main__":
    main()
