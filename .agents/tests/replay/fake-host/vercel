#!/usr/bin/env python3
"""A stand-in for the Vercel CLI, for replaying a launch without an account.

A replay scenario on the Vercel recipe needs a host that keeps a list of
deployments, builds `main` when it moves, and answers the recipe's commands.
The real host needs an account and a network, and a run with nobody watching
must never reach either. So this answers instead.

It is not a Vercel simulator. It answers the subcommands and options the
recipe's commands use, and the ones a kit reaches for to read or make a deploy:
`ls`, `inspect`, `deploy`, `redeploy`, `promote` and `rollback`. Anything else
is refused to the log and to stderr, so a command nobody modelled shows up
rather than passing quietly.

The host builds from the project's GitHub connection. Each push to `main` on
the remote next door becomes a production deployment, read from that remote's
reflog the next time anything asks. A new build shows as Building to the call
that first sees it and as Ready to every call after, and the live address
moves to it then. `deploy`, `redeploy` and `promote` make or move a deployment
themselves, which is how a second deploy of the same version shows up.

`deploy` prints a long build log with the success line and the address near
the end, then a few lines of hints. A kit that cuts that output short cannot
tell whether it worked. Reading all of it, or the list of deployments, can.

State lives in one JSON file named by FAKE_HOST_STATE, beside the project
rather than in it. Every call is logged to FAKE_HOST_LOG. Where the state file
does not exist, the run is not one of these scenarios, and the real command
answers as it would without this folder on PATH.
"""

import json
import os
import random
import string
import subprocess
import sys
from datetime import datetime, timezone

STATE = os.environ.get("FAKE_HOST_STATE", "")
LOG = os.environ.get("FAKE_HOST_LOG", (STATE + ".log") if STATE else "")
VERSION = "60.0.0"
HEADER = "Vercel CLI %s" % VERSION


def delegate(name):
    """Hand the call to the real command, for any run that is not ours."""
    here = os.path.realpath(os.path.dirname(os.path.abspath(__file__)))
    for folder in os.environ.get("PATH", "").split(os.pathsep):
        if not folder or os.path.realpath(folder) == here:
            continue
        candidate = os.path.join(folder, name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            os.execv(candidate, [candidate] + sys.argv[1:])
    sys.stderr.write("%s: command not found\n" % name)
    sys.exit(127)


def sibling(name):
    """Load another stand-in in this folder as a module."""
    import importlib.machinery
    import importlib.util
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), name)
    loader = importlib.machinery.SourceFileLoader("fake_" + name, path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def note(line):
    if not LOG:
        return
    with open(LOG, "a") as handle:
        handle.write(line + "\n")


def unsupported(argv, why="not modelled"):
    note("UNSUPPORTED\tvercel %s\t%s" % (" ".join(argv), why))
    sys.stderr.write(
        "vercel (rehearsal stand-in): 'vercel %s' is not supported here (%s).\n"
        "This is the test harness, not the real Vercel CLI.\n" % (" ".join(argv), why))
    sys.exit(1)


def load(path=None):
    with open(path or STATE) as handle:
        return json.load(handle)


def save(state, path=None):
    with open(path or STATE, "w") as handle:
        json.dump(state, handle, indent=1)


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def new_id():
    return "".join(random.choice(string.ascii_lowercase + string.digits) for _ in range(9))


def deployment_url(state, ident):
    return "%s-%s-%s.vercel.app" % (state["project"], ident, state["team"])


def add_deployment(state, commit, target, source, branch="main", ready=False):
    ident = new_id()
    dep = {
        "id": "dpl_" + ident,
        "url": deployment_url(state, ident),
        "target": target,
        "branch": branch,
        "commit": commit,
        "source": source,
        "state": "READY" if ready else "BUILDING",
        "seen": False,
        "created": now(),
    }
    state["deployments"].append(dep)
    if ready and target == "production":
        state["alias"] = dep["id"]
    return dep


def main_pushes(remote):
    """Every commit `main` pointed at on the remote, oldest first."""
    done = subprocess.run(["git", "--git-dir", remote, "log", "-g", "--format=%H",
                           "refs/heads/main"], capture_output=True, text=True)
    if done.returncode != 0:
        return []
    return [line for line in done.stdout.split() if line][::-1]


def sync(state):
    """Build each push to main the host has not built yet, as a connected
    repository does. Returns the deployments it added."""
    pushes = main_pushes(state.get("remote", ""))
    fresh = pushes[state.get("pushes_built", 0):]
    state["pushes_built"] = len(pushes)
    return [add_deployment(state, commit, "production", "git") for commit in fresh]


def tick(state):
    """A build the last call saw as Building is Ready now, and a production
    build that becomes Ready takes the live address. A build nobody has seen
    yet is seen, and stays Building for this one call."""
    for dep in state["deployments"]:
        if dep["state"] == "BUILDING" and dep["seen"]:
            finish(state, dep)
    for dep in state["deployments"]:
        if dep["state"] == "BUILDING":
            dep["seen"] = True


def finish(state, dep):
    dep["state"] = "READY"
    if dep["target"] == "production" and not state.get("rolled_back"):
        state["alias"] = dep["id"]


def find(state, target):
    """A deployment given as an id, an address, or the live address."""
    target = target.replace("https://", "").replace("http://", "").rstrip("/")
    if target == state["production_url"]:
        return find(state, state["alias"])
    for dep in state["deployments"]:
        if target in (dep["id"], dep["id"][4:], dep["url"]):
            return dep
    return None


def age(created):
    then = datetime.strptime(created, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    seconds = max(0, int((datetime.now(timezone.utc) - then).total_seconds()))
    for size, unit in ((86400, "d"), (3600, "h"), (60, "m")):
        if seconds >= size:
            return "%d%s" % (seconds // size, unit)
    return "%ds" % seconds


STATUS = {"READY": "● Ready", "BUILDING": "● Building", "ERROR": "● Error"}

# Options every command takes, and whether each takes a value.
GLOBAL = {"--cwd": True, "--scope": True, "-S": True, "--team": True, "-T": True,
          "--token": True, "-t": True, "--debug": False, "-d": False,
          "--no-color": False, "--global-config": True, "-Q": True,
          "--local-config": True, "-A": True}


def parse(argv, flags, valued):
    """Split argv into positional words and options, refusing any option the
    command does not document."""
    words, options = [], {}
    i = 0
    while i < len(argv):
        arg = argv[i]
        name, _, inline = arg.partition("=") if arg.startswith("--") else (arg, "", "")
        if arg.startswith("-") and arg != "-":
            if name in flags:
                options[name] = True
            elif name in valued or GLOBAL.get(name):
                if inline:
                    options[name] = inline
                else:
                    if i + 1 >= len(argv):
                        return None, None
                    options[name] = argv[i + 1]
                    i += 1
            elif name in GLOBAL:
                options[name] = True
            else:
                return None, None
        else:
            words.append(arg)
        i += 1
    return words, options


