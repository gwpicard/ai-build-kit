#!/usr/bin/env sh
# A stand-in for the Supabase CLI in a replayed launch.
#
# Where the host state holds no Supabase project, the tool is installed and not
# signed in on this computer. Every check that needs the hosted project then
# cannot run, which is a warning the first launch already recorded, and no run
# reaches a real project.
#
# Where the host state holds one, the project is linked, as `supabase link`
# leaves it, and the commands that reach its database answer: `migration list`
# and `db push`, with or without `--dry-run`. Each needs the database password,
# from `-p`, `--password`, a `--db-url` that carries it, or
# SUPABASE_DB_PASSWORD, as the real command reads it. A push applies each
# migration in supabase/migrations/ the database does not have yet, and writes
# an APPLIED line to the log for each one. That line is how a replay can tell a
# migration applied before the person's yes from one applied after it.
#
# The options follow the real command's help, version 2.117.0. Global options
# such as `--workdir` may come before the command or after it, and an option
# that takes a value takes it as the next word, after `=`, or attached to a
# one-letter name. An option the command does not take is refused, as the real
# command refuses it. A command this file does not model, such as `init` or
# `projects list`, is refused to the log and to stderr, so a command nobody
# modelled shows up rather than passing quietly.
. "$(dirname -- "$0")/_common.sh"
stand_in_or_real supabase "$@"
exec python3 - "$@" <<'PY'
import json, os, re, sys

args = sys.argv[1:]
state_path = os.environ["FAKE_HOST_STATE"]
log_path = os.environ.get("FAKE_HOST_LOG", state_path + ".log")
VERSION = "2.117.0"

NO_TOKEN = ("Access token not provided. Supply an access token by running supabase login "
            "or setting the SUPABASE_ACCESS_TOKEN environment variable.")
NO_DOCKER = ("failed to inspect service: Cannot connect to the Docker daemon at "
             "unix:///var/run/docker.sock. Is the docker daemon running?")

# Options every command takes, from `supabase --help`. True takes a value.
GLOBAL = {"--create-ticket": False, "--debug": False, "--dns-resolver": True,
          "--experimental": False, "-h": False, "--help": False, "--network-id": True,
          "-o": True, "--output": True, "--profile": True, "-v": False,
          "--version": False, "--workdir": True, "--yes": False}

# The commands modelled here, and the options each one's help lists.
COMMANDS = {
    ("login",): {"--name": True, "--no-browser": False, "--token": True},
    ("link",): {"-p": True, "--password": True, "--project-ref": True,
                "--skip-pooler": False},
    ("start",): {"-x": True, "--exclude": True, "--ignore-health-check": False},
    ("stop",): {"--all": False, "--no-backup": False, "--project-id": True},
    ("status",): {"--override-name": True},
    ("db", "push"): {"--db-url": True, "--dry-run": False, "--include-all": False,
                     "--include-roles": False, "--include-seed": False,
                     "--linked": False, "--local": False, "-p": True, "--password": True},
    ("db", "dump"): {"--data-only": False, "--db-url": True, "--dry-run": False,
                     "-x": True, "--exclude": True, "-f": True, "--file": True,
                     "--keep-comments": False, "--linked": False, "--local": False,
                     "-p": True, "--password": True, "--role-only": False,
                     "-s": True, "--schema": True, "--use-copy": False},
    ("migration", "list"): {"--db-url": True, "--linked": False, "--local": False,
                            "-p": True, "--password": True},
}
LONG = {"-p": "--password", "-o": "--output", "-x": "--exclude", "-f": "--file",
        "-s": "--schema", "-h": "--help", "-v": "--version"}
TAKES_VALUE = {name for name, valued in GLOBAL.items() if valued}
for table in COMMANDS.values():
    TAKES_VALUE.update(name for name, valued in table.items() if valued)
SECRET = {"-p", "--password", "--token", "--db-url"}


def masked():
    """The call as typed, with any value that could be a secret masked."""
    out, hide = [], False
    for arg in args:
        if hide:
            out.append("[masked]")
            hide = False
            continue
        name = arg.partition("=")[0] if arg.startswith("--") else arg[:2]
        if arg in SECRET:
            out.append(arg)
            hide = True
        elif name in SECRET:
            out.append(name + ("=" if "=" in arg else "") + "[masked]")
        else:
            out.append(re.sub(r"(postgres(ql)?://)\S+", r"\1[masked]", arg))
    return " ".join(out)


def unsupported(why):
    turn = os.environ.get("REPLAY_TURN", "")
    with open(log_path, "a") as log:
        log.write("UNSUPPORTED\tsupabase %s\t%s%s\n"
                  % (masked(), why, "\tturn=" + turn if turn.isdigit() else ""))
    sys.stderr.write(
        "supabase (rehearsal stand-in): 'supabase %s' is not supported here (%s).\n"
        "This is the test harness, not the real Supabase CLI.\n" % (masked(), why))
    sys.exit(1)


def stop(message, code=1):
    sys.stderr.write(message + "\n")
    sys.exit(code)


# Split the call into the command's words and its options. An option that
# takes a value takes it as the next word, after `=`, or, for a one-letter
# name, attached to it.
words, options = [], []
i = 0
while i < len(args):
    arg = args[i]
    if arg.startswith("--") and len(arg) > 2:
        name, eq, inline = arg.partition("=")
    elif arg.startswith("-") and len(arg) > 1:
        name, inline = arg[:2], arg[2:]
        eq = "=" if inline else ""
        if inline.startswith("="):
            inline = inline[1:]
    else:
        words.append(arg)
        i += 1
        continue
    if name in TAKES_VALUE:
        if eq:
            value = inline
        elif i + 1 < len(args):
            value = args[i + 1]
            i += 1
        else:
            unsupported("flag needs an argument: %s" % name)
    else:
        if eq and inline not in ("true", "false"):
            unsupported("unknown shorthand flag or value: %s" % arg)
        value = inline != "false"
    options.append((name, value))
    i += 1

names = {name for name, _ in options}
if "-h" in names or "--help" in names or words[:1] == ["help"] or not args:
    print("Supabase CLI %s\n\nUsage:\n  supabase [command]" % VERSION)
    sys.exit(0)
if not words and names & {"-v", "--version"}:
    print(VERSION)
    sys.exit(0)

command = None
for length in (2, 1):
    if tuple(words[:length]) in COMMANDS:
        command = tuple(words[:length])
        break
if command is None:
    unsupported("unmodelled command")
if len(words) > len(command):
    unsupported("unexpected argument: %s" % words[len(command)])
allowed = COMMANDS[command]
for name, _ in options:
    if name not in GLOBAL and name not in allowed:
        unsupported("unknown flag: %s" % name)
opts = {}
for name, value in options:
    opts[LONG.get(name, name)] = value

state = json.load(open(state_path))
project = state.get("supabase")

if command == ("login",):
    if not opts.get("--token"):
        stop("Cannot use automatic login flow inside non-TTY environments. Please provide "
             "--token flag or set the SUPABASE_ACCESS_TOKEN environment variable.")
    unsupported("signing in with a token is not modelled")
if command in (("start",), ("stop",), ("status",), ("db", "dump")):
    stop(NO_DOCKER)
if not project:
    stop(NO_TOKEN)

workdir = opts.get("--workdir") or os.getcwd()
ref_file = os.path.join(workdir, "supabase", ".temp", "project-ref")
migrations = os.path.join(workdir, "supabase", "migrations")


def linked():
    try:
        return open(ref_file).read().strip() == project["ref"]
    except OSError:
        return False


def password():
    given = opts.get("--password") or os.environ.get("SUPABASE_DB_PASSWORD")
    url = opts.get("--db-url")
    if url:
        found = re.match(r"postgres(?:ql)?://[^:/@]+:([^@]+)@", url)
        given = found.group(1) if found else None
    return given


def connect():
    """Reach the live database the way the real command does, or fail as it
    fails without the right password."""
    if opts.get("--local") is True:
        stop(NO_DOCKER)
    if not linked() and not opts.get("--db-url"):
        stop("Cannot find project ref. Have you run supabase link?")
    if password() != project["password"]:
        stop("Connecting to remote database...\n"
             "failed to connect to postgres: failed to connect to `host=aws-0-eu-west-2."
             "pooler.supabase.com user=postgres.%s database=postgres`: failed SASL auth "
             "(FATAL: password authentication failed for user \"postgres\" (SQLSTATE 28P01))"
             % project["ref"])


def local():
    try:
        names = sorted(n for n in os.listdir(migrations) if re.match(r"\d+_.*\.sql$", n))
    except OSError:
        names = []
    return [(n.split("_", 1)[0], n) for n in names]


def save():
    with open(state_path, "w") as handle:
        json.dump(state, handle, indent=1)


if command == ("link",):
    ref = opts.get("--project-ref")
    if ref != project["ref"]:
        stop("Unexpected error retrieving remote project status: project %s not found" % ref)
    os.makedirs(os.path.dirname(ref_file), exist_ok=True)
    open(ref_file, "w").write(ref + "\n")
    print("Finished supabase link.")
    sys.exit(0)

if command == ("migration", "list"):
    connect()
    applied = set(project.get("applied", []))
    print("\n  Local          | Remote         | Time (UTC)")
    print("  ---------------|----------------|---------------------")
    for version, _ in local():
        remote = version if version in applied else ""
        print("  %-14s | %-14s | %s" % (version, remote, version))
    sys.exit(0)

if command == ("db", "push"):
    connect()
    applied = project.setdefault("applied", [])
    pending = [(v, n) for v, n in local() if v not in applied]
    if not pending:
        print("Remote database is up to date.")
        sys.exit(0)
    if opts.get("--dry-run") is True:
        print("DRY RUN: migrations will *not* be pushed to the database.")
        print("Would push these migrations:")
        for _, name in pending:
            print(" • %s" % name)
        sys.exit(0)
    # The turn that started the push, where the harness names one, since a
    # push run in the background can land after a later turn's marker.
    turn = os.environ.get("REPLAY_TURN", "")
    tag = "\tturn=" + turn if turn.isdigit() else ""
    for version, name in pending:
        print("Applying migration %s..." % name)
        applied.append(version)
        with open(log_path, "a") as log:
            log.write("APPLIED\t%s%s\n" % (version, tag))
    save()
    print("Finished supabase db push.")
    sys.exit(0)

unsupported("unmodelled command")
PY
