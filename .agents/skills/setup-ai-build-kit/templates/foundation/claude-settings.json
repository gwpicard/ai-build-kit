{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Write(**/.claude/settings.json)",
      "Edit(**/.claude/settings.json)",
      "Write(**/.claude/settings.local.json)",
      "Edit(**/.claude/settings.local.json)",
      "Bash(* > .claude/settings.json*)",
      "Bash(* >> .claude/settings.json*)",
      "Bash(* > .claude/settings.local.json*)",
      "Bash(* >> .claude/settings.local.json*)",
      "Bash(tee .claude/settings.json*)",
      "Bash(tee .claude/settings.local.json*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.env.preview)",
      "Read(**/.env.production.local)",
      "Read(**/.env.development.local)",
      "Read(**/.env.test.local)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * +main)",
      "Bash(git push * +main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -fR:*)",
      "Bash(rm -r -f:*)",
      "Bash(rm -f -r:*)",
      "Bash(rm -R -f:*)",
      "Bash(rm -f -R:*)",
      "Bash(rm --recursive --force:*)",
      "Bash(rm --force --recursive:*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git *core.hooksPath*)",
      "Bash(git *core.hookspath*)",
      "Bash(git checkout .)",
      "Bash(git checkout * .)",
      "Bash(git restore .)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git checkout -f*)",
      "Bash(git checkout * -f*)",
      "Bash(git checkout *--force*)",
      "Bash(git switch -f*)",
      "Bash(git switch * -f*)",
      "Bash(git switch *--force*)",
      "Bash(git switch *--discard-changes*)",
      "Bash(git restore -- *)",
      "Bash(git restore *--worktree*)",
      "Bash(git restore -W*)",
      "Bash(git restore * -W*)",
      "Bash(git clean -*f*)",
      "Bash(git clean * -*f*)",
      "Bash(git reset * --hard*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(security find-*)",
      "Bash(security dump-keychain:*)",
      "Bash(gh auth token:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *merges*)",
      "Bash(gh api graphql *mergePullRequest*)",
      "Bash(gh auth status*-t*)",
      "Bash(git credential fill*)",
      "Bash(git credential-*)",
      "Bash(*.config/gh/hosts.yml*)",
      "Bash(*GitHub CLI/hosts.yml*)",
      "Bash(*com.vercel.cli/auth.json*)",
      "Bash(*.vercel/auth.json*)",
      "Bash(*.supabase/access-token*)",
      "Bash(*Application Support/supabase*)",
      "Bash(*.docker/config.json*)",
      "Read(//**/.config/gh/hosts.yml)",
      "Read(//**/GitHub CLI/hosts.yml)",
      "Read(//**/com.vercel.cli/auth.json)",
      "Read(//**/.vercel/auth.json)",
      "Read(//**/.supabase/access-token)",
      "Read(~/.vercel/**)",
      "Read(~/.supabase/**)",
      "Read(//**/Library/Application Support/supabase/**)",
      "Read(//**/.docker/config.json)"
    ],
    "ask": [
      "Bash(*merge.py*--approved*)",
      "Bash(*merge.py*--resume*)",
      "Bash(gh api *git/refs*)",
      "Bash(gh api graphql *createRef*)",
      "Bash(gh api graphql *updateRef*)",
      "Bash(gh api graphql *deleteRef*)",
      "Bash(git restore *)",
      "Bash(supabase db push:*)",
      "Bash(supabase *config push*)",
      "Bash(vercel api *PATCH*)",
      "Bash(vercel api *patch*)",
      "Bash(vercel curl*)",
      "Bash(*GATE_READ=yes*)",
      "Bash(*GATE_READ=\"yes\"*)",
      "Bash(*GATE_READ='yes'*)",
      "Bash(*PREVIEW_HEALTH=yes*)",
      "Bash(*PREVIEW_HEALTH=\"yes\"*)",
      "Bash(*PREVIEW_HEALTH='yes'*)",
      "Bash(vercel project protection enable*)",
      "Bash(vercel project protection disable*)",
      "Bash(*set-access.sh*)",
      "Bash(*set-signup.sh*)",
      "Bash(vercel *--prod*)",
      "Bash(vercel *--target*production*)",
      "Bash(vercel rollback:*)",
      "Bash(vercel promote:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh repo edit *--visibility*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *-X=DELETE*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method=DELETE*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/guard-secrets.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/redact-secrets.sh\" Bash"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/redact-secrets.sh\" Read"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/redact-secrets.sh\" Grep"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hook=\"$CLAUDE_PROJECT_DIR/.agents/hooks/session-start.sh\"; if [ -x \"$hook\" ]; then \"$hook\" --claude-hook; fi"
          }
        ]
      }
    ]
  }
}
