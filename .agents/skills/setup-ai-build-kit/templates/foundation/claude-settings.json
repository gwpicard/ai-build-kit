{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * +main)",
      "Bash(git push * +main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -fR:*)",
      "Bash(rm -r -f:*)",
      "Bash(rm -f -r:*)",
      "Bash(rm -R -f:*)",
      "Bash(rm -f -R:*)",
      "Bash(rm --recursive --force:*)",
      "Bash(rm --force --recursive:*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git checkout .)",
      "Bash(git checkout * .)",
      "Bash(git restore .)",
      "Bash(git restore * .)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(security find-*)",
      "Bash(security dump-keychain:*)",
      "Bash(gh auth token:*)",
      "Read(//**/.config/gh/hosts.yml)",
      "Read(//**/GitHub CLI/hosts.yml)",
      "Read(//**/com.vercel.cli/auth.json)",
      "Read(//**/.vercel/auth.json)",
      "Read(//**/.supabase/access-token)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *merges*)",
      "Bash(gh api graphql *mergePullRequest*)",
      "Bash(supabase config push:*)",
      "Bash(supabase db push:*)",
      "Bash(vercel *--prod*)",
      "Bash(vercel *--target*production*)",
      "Bash(vercel rollback:*)",
      "Bash(vercel promote:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh repo edit *--visibility*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *-X=DELETE*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method=DELETE*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hook=\"$CLAUDE_PROJECT_DIR/.agents/hooks/session-start.sh\"; if [ -x \"$hook\" ]; then \"$hook\" --claude-hook; fi"
          }
        ]
      }
    ]
  }
}
