{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hook=\"$CLAUDE_PROJECT_DIR/.agents/hooks/session-start.sh\"; if [ -x \"$hook\" ]; then \"$hook\" --claude-hook; fi"
          }
        ]
      }
    ]
  }
}
