    }
  ],
  "$id": "https://github.com/gwpicard/ai-build-kit/hosting/handover.schema.json",
  "$defs": {
    "reference": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?:https://[a-zA-Z0-9.-]+(?::[0-9]{1,5})?(?:/[A-Za-z0-9_.-]+)*/?|[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*)$",
      "description": "A repository path or HTTPS address without credentials, query, fragment, percent encoding or copied key material. Use an evidence file path instead of a signed address.",
      "allOf": [
        {
          "$ref": "#/$defs/credentialFreeValue"
        }
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
      "allOf": [
        {
          "$ref": "#/$defs/credentialFreeValue"
        }
      ]
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "preview"
            },
            "tool": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "handover": {
              "$ref": "#/$defs/path"
            },
            "branch": {
              "type": "string",
              "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_][A-Za-z0-9_./-]*$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          },
          "required": [
            "action",
            "tool",
            "handover",
            "branch",
            "commit"
          ],
          "additionalProperties": false,
          "description": "Make an isolated preview of this branch at this commit and return its address and evidence reference."
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "logs"
            },
            "tool": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "handover": {
              "$ref": "#/$defs/path"
            },
            "minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440
            }
          },
          "required": [
            "action",
            "tool",
            "handover",
            "minutes"
          ],
          "additionalProperties": false,
          "description": "Return recent redacted logs for the named tool, covering the requested number of minutes."
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "health"
            },
            "tool": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "handover": {
              "$ref": "#/$defs/path"
            }
          },
          "required": [
            "action",
            "tool",
            "handover"
          ],
          "additionalProperties": false,
          "description": "Check the running tool and return its result and evidence reference."
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "release"
            },
            "tool": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "handover": {
              "$ref": "#/$defs/path"
            },
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          },
          "required": [
            "action",
            "tool",
            "handover",
            "commit"
          ],
          "additionalProperties": false,
          "description": "Put this merged commit live after the host side obtains the required approval and rehearses its migration."
        }
      ],
      "description": "The four requests to AI Host Kit. A request is intent, not approval. The host owns execution and writes its own records; the build kit never writes host-record.json.",
      "allOf": [
        {
          "$ref": "#/$defs/credentialFreeValue"
        }
      ]
    },
    "response": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "could-not-check"
          ]
        },
        "location": {
          "$ref": "#/$defs/reference"
        },
        "evidence": {
          "$ref": "#/$defs/reference"
        }
      },
      "required": [
        "status",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/credentialFreeValue"
        }
      ]
    },
    "credentialFreeValue": {
      "description": "Reject recognisable credential URLs and copied key material throughout declarations and extensions. Arbitrary secrets can resemble ordinary prose.",
      "anyOf": [
        {
          "type": "string",
          "not": {
            "pattern": "(?:[a-zA-Z][a-zA-Z0-9+.-]*://[^/\\s?#]*@|-----[bB][eE][gG][iI][nN]|(?:[pP][aA][sS][sS][wW][oO][rR][dD]|[sS][eE][cC][rR][eE][tT]|[tT][oO][kK][eE][nN]|[sS][iI][gG][nN][aA][tT][uU][rR][eE]|[sS][iI][gG]|[kK][eE][yY])\\s*=|(?:AKIA|ASIA)[A-Z0-9]{16}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{20,})"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "pattern": "(?:[a-zA-Z][a-zA-Z0-9+.-]*://[^/\\s?#]*@|-----[bB][eE][gG][iI][nN]|(?:[pP][aA][sS][sS][wW][oO][rR][dD]|[sS][eE][cC][rR][eE][tT]|[tT][oO][kK][eE][nN]|[sS][iI][gG][nN][aA][tT][uU][rR][eE]|[sS][iI][gG]|[kK][eE][yY])\\s*=|(?:AKIA|ASIA)[A-Z0-9]{16}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{20,})"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/credentialFreeValue"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/credentialFreeValue"
          }
        },
        {
          "type": [
            "number",
            "boolean",
            "null"
          ]
        }
      ]
    }
  }
}
