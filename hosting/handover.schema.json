                "required": [
                  "MICROSOFT_TENANT_ID"
                ]
              }
            }
          },
          "config": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "name": {
                      "const": "MICROSOFT_TENANT_ID"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sign_in": {
            "properties": {
