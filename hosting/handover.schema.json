{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Build Kit handover v1",
  "description": "AI Build Kit owns hosting/handover.json and this schema. AI Host Kit vendors the published release copy unchanged. The config list declares secrets and settings by name only. Requests are defined in $defs/request. Writers use this exact supported minor version; a future minor may add optional fields, but never value-bearing secret metadata. Unknown major versions require a supporting reader update. Reference fields accept credential-free HTTPS addresses or repository paths, without queries, fragments, user information, escapes or key text. Validation cannot detect arbitrary secrets disguised as ordinary prose.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "successor": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "owner"
      ],
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "dockerfile": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "dockerfile"
      ],
      "additionalProperties": false
    },
    "processes": {
      "type": "object",
      "properties": {
        "web": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": [
            "command",
            "port"
          ],
          "additionalProperties": false
        },
        "worker": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "command"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "migrate": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "when": {
              "const": "before-release"
            }
          },
          "required": [
            "command",
            "when"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "web",
        "migrate"
      ],
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/[^\\s?#]*$"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "database",
              "worker"
            ]
          },
          "uniqueItems": true,
          "minItems": 1,
          "contains": {
            "const": "database"
          }
        },
        "commit_env": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      },
      "required": [
        "path",
        "checks",
        "commit_env"
      ],
      "additionalProperties": false
    },
    "config": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "secret",
              "setting"
            ]
          },
          "phase": {
            "type": "string",
            "enum": [
              "build",
              "runtime"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "generated",
              "person",
              "host"
            ]
          }
        },
        "required": [
          "name",
          "kind",
          "phase",
          "source"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "secret"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "phase": {
                  "const": "runtime"
                }
              }
            }
          }
        ],
        "description": "Declare names and where they come from. Never put values here. Secret names are supplied at runtime."
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "min_major": {
          "type": "integer",
          "minimum": 1
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "roles": {
          "type": "object",
          "properties": {
            "migrate": {
              "const": "owner"
            },
            "app": {
              "const": "no-owner-no-bypassrls",
              "description": "The app role owns no table and cannot bypass row-level security."
            }
          },
          "required": [
            "migrate",
            "app"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "min_major",
        "extensions",
        "roles"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "properties": {
        "port": {
          "type": "string",
          "enum": [
            "s3",
            "azure-blob"
          ]
        },
        "buckets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "private": {
                "type": "boolean"
              },
              "link_minutes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "name",
              "private",
              "link_minutes"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "port",
        "buckets"
      ],
      "additionalProperties": false
    },
    "email": {
      "type": "object",
      "properties": {
        "transport": {
          "const": "smtp"
        },
        "sender_domain": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,}$"
        },
        "inbound": {
          "type": "boolean"
        }
      },
      "required": [
        "transport",
        "sender_domain",
        "inbound"
      ],
      "additionalProperties": false
    },
    "jobs": {
      "type": "object",
      "properties": {
        "library": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "type": "string",
          "enum": [
            "worker",
            "in-app",
            "host-tick"
          ]
        },
        "longest_job_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "schedules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "cron": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S+(?:[ \\t]+\\S+){4}$"
              }
            },
            "required": [
              "name",
              "cron"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "library",
        "runner",
        "longest_job_seconds",
        "schedules"
      ],
      "additionalProperties": false
    },
    "sign_in": {
      "type": "object",
      "properties": {
        "staff": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "entra",
                    "google",
                    "oidc"
                  ]
                },
                "directory": {
                  "type": "string",
                  "minLength": 1
                },
                "outside_refused_test": {
                  "$ref": "#/$defs/path"
                },
                "redirect_path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^/[^\\s?#]*$"
                }
              },
              "required": [
                "provider",
                "directory",
                "outside_refused_test"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when no staff directory is used. Null with outsiders none records a template whose sign-in is not configured yet; it does not approve public access."
        },
        "outsiders": {
          "type": "string",
          "enum": [
            "email-link",
            "none"
          ]
        }
      },
      "required": [
        "staff",
        "outsiders"
      ],
      "additionalProperties": false
    },
    "ai": {
      "type": "object",
      "properties": {
        "needed": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "text",
              "vision",
              "pdf"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "residency": {
          "type": "string",
          "enum": [
            "uk",
            "eu",
            "any"
          ]
        }
      },
      "required": [
        "needed"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "needed": {
                "const": true
              }
            },
            "required": [
              "needed"
            ]
          },
          "then": {
            "required": [
              "capabilities",
              "residency"
            ]
          }
        }
      ]
    },
    "access": {
      "type": "string",
      "enum": [
        "private",
        "invitation",
        "public"
      ]
    },
    "residency": {
      "type": "string",
      "enum": [
        "uk",
        "eu",
        "any"
      ]
    },
    "data_risk": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "recovery": {
      "type": "object",
      "properties": {
        "max_data_loss_hours": {
          "type": "number",
          "minimum": 0
        },
        "max_restore_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "max_data_loss_hours",
        "max_restore_hours"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "longest_request_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1
        },
        "outbound_internet": {
          "type": "boolean"
        }
      },
      "required": [
        "longest_request_seconds",
        "memory_mb",
        "outbound_internet"
      ],
      "additionalProperties": false
    },
    "previews": {
      "type": "object",
      "properties": {
        "wanted": {
          "type": "boolean"
        },
        "data": {
          "const": "separate-database"
        }
      },
      "required": [
        "wanted",
        "data"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "tool",
    "image",
    "processes",
    "health",
    "config",
    "postgres",
    "sign_in",
    "access",
    "residency",
    "data_risk",
    "recovery",
    "limits",
    "previews"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "jobs": {
            "properties": {
              "runner": {
                "const": "worker"
              }
            },
            "required": [
              "runner"
            ]
          }
        },
        "required": [
          "jobs"
        ]
      },
      "then": {
        "properties": {
          "processes": {
            "required": [
              "worker"
            ],
            "properties": {
              "worker": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sign_in": {
            "properties": {
              "outsiders": {
                "const": "email-link"
              }
            },
            "required": [
              "outsiders"
            ]
          }
        },
        "required": [
          "sign_in"
        ]
      },
      "then": {
        "required": [
          "email"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "access": {
            "enum": [
              "private",
              "invitation"
            ]
          }
        },
        "required": [
          "access"
        ]
      },
      "then": {
        "properties": {
          "files": {
            "properties": {
              "buckets": {
                "items": {
                  "properties": {
                    "private": {
                      "const": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$id": "https://github.com/gwpicard/ai-build-kit/hosting/handover.schema.json",
  "$defs": {
    "reference": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?:https://[a-zA-Z0-9.-]+(?::[0-9]{1,5})?(?:/[A-Za-z0-9_.-]+)*/?|[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*)$",
      "description": "A repository path or HTTPS address without credentials, query, fragment, percent encoding or copied key material. Use an evidence file path instead of a signed address."
    },
    "path": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "preview"
            },
            "tool": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "handover": {
              "$ref": "#/$defs/path"
            },
            "branch": {
              "type": "string",
              "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_][A-Za-z0-9_./-]*$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          },
          "required": [
            "action",
            "tool",
            "handover",
            "branch",
            "commit"
          ],
          "additionalProperties": false,
          "description": "Make an isolated preview of this branch at this commit and return its address and evidence reference."
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "logs"
            },
            "tool": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "handover": {
              "$ref": "#/$defs/path"
            },
            "minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440
            }
          },
          "required": [
            "action",
            "tool",
            "handover",
            "minutes"
          ],
          "additionalProperties": false,
          "description": "Return recent redacted logs for the named tool, covering the requested number of minutes."
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "health"
            },
            "tool": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "handover": {
              "$ref": "#/$defs/path"
            }
          },
          "required": [
            "action",
            "tool",
            "handover"
          ],
          "additionalProperties": false,
          "description": "Check the running tool and return its result and evidence reference."
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "release"
            },
            "tool": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "handover": {
              "$ref": "#/$defs/path"
            },
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          },
          "required": [
            "action",
            "tool",
            "handover",
            "commit"
          ],
          "additionalProperties": false,
          "description": "Put this merged commit live after the host side obtains the required approval and rehearses its migration."
        }
      ],
      "description": "The four requests to AI Host Kit. A request is intent, not approval. The host owns execution and writes its own records; the build kit never writes host-record.json."
    },
    "response": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "could-not-check"
          ]
        },
        "location": {
          "$ref": "#/$defs/reference"
        },
        "evidence": {
          "$ref": "#/$defs/reference"
        }
      },
      "required": [
        "status",
        "evidence"
      ],
      "additionalProperties": false
    }
  }
}
