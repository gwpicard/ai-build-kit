{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Build Kit handover v1",
  "description": "AI Build Kit owns hosting/handover.json and this schema. AI Host Kit vendors the published release copy unchanged. The config list declares secrets and settings by name only. Requests are defined in $defs/request. Readers accept 1.x; minor versions may add optional fields outside config entries and readers report unknown fields before ignoring them. Config entries remain closed to their descriptive fields in every minor version. After publication, a removal, changed meaning or new required field needs a new major version and a supporting reader update. Reference fields accept credential-free HTTPS addresses or repository paths, without queries, fragments, user information, escapes or key text. Validation cannot detect arbitrary secrets disguised as ordinary prose.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "successor": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "owner"
      ],
      "additionalProperties": true
    },
    "image": {
      "type": "object",
      "properties": {
        "dockerfile": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "dockerfile"
      ],
      "additionalProperties": true
    },
    "processes": {
      "type": "object",
      "properties": {
        "web": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": [
            "command",
            "port"
          ],
          "additionalProperties": true
        },
        "worker": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "command"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "migrate": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "when": {
              "const": "before-release"
            }
          },
          "required": [
            "command",
            "when"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "web",
        "migrate"
      ],
      "additionalProperties": true
    },
    "health": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/[^\\s?#]*$"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "database",
              "worker"
            ]
          },
          "uniqueItems": true,
          "minItems": 1,
          "contains": {
            "const": "database"
          }
        },
        "commit_env": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      },
      "required": [
        "path",
        "checks",
        "commit_env"
      ],
      "additionalProperties": true
    },
    "config": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "secret",
              "setting"
            ]
          },
          "phase": {
            "type": "string",
            "enum": [
              "build",
              "runtime"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "generated",
              "person",
              "host"
            ]
          }
        },
        "required": [
          "name",
          "kind",
          "phase",
          "source"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "secret"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "phase": {
                  "const": "runtime"
                }
              }
            }
          }
        ],
        "description": "Declare names and where they come from. Never put values here. Secret names are supplied at runtime."
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "min_major": {
          "type": "integer",
          "minimum": 1
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "roles": {
          "type": "object",
          "properties": {
            "migrate": {
              "const": "owner"
            },
            "app": {
              "const": "no-owner-no-bypassrls",
              "description": "The app role owns no table and cannot bypass row-level security."
            },
            "auth": {
              "const": "no-owner-no-bypassrls"
            }
          },
          "required": [
            "migrate",
            "app"
          ],
          "additionalProperties": true
        },
        "sign_in": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "tables": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "migration": {
              "$ref": "#/$defs/path"
            },
            "runtime_role": {
              "type": "string",
              "minLength": 1
            },
            "permissions": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "schema",
            "tables",
            "owner",
            "migration",
            "runtime_role",
            "permissions"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "min_major",
        "extensions",
        "roles"
      ],
      "additionalProperties": true
    },
    "files": {
      "type": "object",
      "properties": {
        "port": {
          "type": "string",
          "enum": [
            "s3",
            "azure-blob"
          ]
        },
        "buckets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "private": {
                "type": "boolean"
              },
              "link_minutes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "name",
              "private",
              "link_minutes"
            ],
            "additionalProperties": true
          },
          "minItems": 1
        }
      },
      "required": [
        "port",
        "buckets"
      ],
      "additionalProperties": true
    },
    "email": {
      "type": "object",
      "properties": {
        "transport": {
          "const": "smtp"
        },
        "sender_domain": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,}$"
        },
        "inbound": {
          "type": "boolean"
        }
      },
      "required": [
        "transport",
        "sender_domain",
        "inbound"
      ],
      "additionalProperties": true
    },
    "jobs": {
      "type": "object",
      "properties": {
        "library": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "type": "string",
          "enum": [
            "worker",
            "in-app",
            "host-tick"
          ]
        },
        "longest_job_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "schedules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "cron": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S+(?:[ \\t]+\\S+){4}$"
              }
            },
            "required": [
              "name",
              "cron"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "library",
        "runner",
        "longest_job_seconds",
        "schedules"
      ],
      "additionalProperties": true
    },
    "sign_in": {
      "type": "object",
      "properties": {
        "staff": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "entra",
                    "google",
                    "oidc"
                  ]
                },
                "directory": {
                  "type": "string",
                  "minLength": 1
                },
                "outside_refused_test": {
                  "$ref": "#/$defs/path"
                },
                "redirect_path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^/[^\\s?#]*$"
                }
              },
              "required": [
                "provider",
                "directory",
                "outside_refused_test"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when no staff directory is used. Null with outsiders none records a template whose sign-in is not configured yet; it does not approve public access."
        },
        "outsiders": {
          "type": "string",
          "enum": [
            "email-link",
            "none"
          ]
        },
        "staff_provider": {
          "enum": [
            "none",
            "microsoft",
            "google",
            "oidc"
          ]
        },
        "public_origin_env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "configuration": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "secret_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "required_when": {
                "enum": [
                  "always",
                  "staff",
                  "smtp-auth"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "required_when",
              "description"
            ],
            "additionalProperties": true
          }
        },
        "host_setup": {
          "type": "object",
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "request": {
              "type": "string",
              "minLength": 1
            },
            "microsoft": {
              "type": "string",
              "minLength": 1
            },
            "google": {
              "type": "string",
              "minLength": 1
            },
            "callbacks": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^/[^\\s?#]*$"
              },
              "properties": {
                "microsoft": {
                  "type": "string",
                  "pattern": "^/[^\\s?#]*$"
                },
                "google": {
                  "type": "string",
                  "pattern": "^/[^\\s?#]*$"
                }
              },
              "required": [
                "microsoft",
                "google"
              ]
            }
          },
          "required": [
            "owner",
            "request",
            "microsoft",
            "google",
            "callbacks"
          ],
          "additionalProperties": true
        },
        "email_link": {
          "type": "object",
          "properties": {
            "verification_path": {
              "type": "string",
              "pattern": "^/[^\\s?#]*$"
            },
            "requires": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "verification_path",
            "requires"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "staff",
        "outsiders"
      ],
      "additionalProperties": true
    },
    "ai": {
      "type": "object",
      "properties": {
        "needed": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "text",
              "vision",
              "pdf"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "residency": {
          "type": "string",
          "enum": [
            "uk",
            "eu",
            "any"
          ]
        }
      },
      "required": [
        "needed"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "needed": {
                "const": true
              }
            },
            "required": [
              "needed"
            ]
          },
          "then": {
            "required": [
              "capabilities",
              "residency"
            ]
          }
        }
      ]
    },
    "access": {
      "type": "string",
      "enum": [
        "private",
        "invitation",
        "public"
      ]
    },
    "residency": {
      "type": "string",
      "enum": [
        "uk",
        "eu",
        "any"
      ]
    },
    "data_risk": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "recovery": {
      "type": "object",
      "properties": {
        "max_data_loss_hours": {
          "type": "number",
          "minimum": 0
        },
        "max_restore_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "max_data_loss_hours",
        "max_restore_hours"
      ],
      "additionalProperties": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "longest_request_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1
        },
        "outbound_internet": {
          "type": "boolean"
        }
      },
      "required": [
        "longest_request_seconds",
        "memory_mb",
        "outbound_internet"
      ],
      "additionalProperties": true
    },
    "previews": {
      "type": "object",
      "properties": {
        "wanted": {
          "type": "boolean"
        },
        "data": {
          "const": "separate-database"
        }
      },
      "required": [
        "wanted",
        "data"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "tool",
    "image",
    "processes",
    "health",
    "config",
    "postgres",
    "sign_in",
    "access",
    "residency",
    "data_risk",
    "recovery",
    "limits",
    "previews"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "$ref": "#/$defs/credentialFreeValue"
    },
    {
      "if": {
        "properties": {
          "jobs": {
            "properties": {
              "runner": {
                "const": "worker"
              }
            },
            "required": [
              "runner"
            ]
          }
        },
        "required": [
          "jobs"
        ]
      },
      "then": {
        "properties": {
          "processes": {
            "required": [
              "worker"
            ],
            "properties": {
              "worker": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sign_in": {
            "properties": {
              "outsiders": {
                "const": "email-link"
              }
            },
            "required": [
              "outsiders"
            ]
          }
        },
        "required": [
          "sign_in"
        ]
      },
      "then": {
        "required": [
          "email"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "access": {
            "enum": [
              "private",
              "invitation"
            ]
          }
        },
        "required": [
          "access"
        ]
      },
      "then": {
        "properties": {
          "files": {
            "properties": {
              "buckets": {
                "items": {
                  "properties": {
                    "private": {
                      "const": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sign_in": {
            "anyOf": [
              {
                "properties": {
                  "staff": {
                    "type": "object"
                  }
                },
                "required": [
                  "staff"
                ]
              },
              {
                "properties": {
                  "outsiders": {
                    "const": "email-link"
                  }
                },
                "required": [
                  "outsiders"
                ]
              }
            ]
          }
        },
        "required": [
          "sign_in"
        ]
      },
      "then": {
        "properties": {
          "sign_in": {
            "properties": {
              "configuration": {
                "required": [
                  "AUTH_BASE_URL",
                  "AUTH_SECRET_FILE",
                  "AUTH_DATABASE_URL",
                  "STAFF_PROVIDER"
                ]
              },
              "secret_files": {
                "allOf": [
                  {
                    "contains": {
                      "properties": {
                        "name": {
                          "const": "AUTH_SECRET_FILE"
                        },
                        "required_when": {
                          "const": "always"
                        }
                      },
                      "required": [
                        "name",
                        "required_when"
                      ]
                    }
                  },
                  {
                    "contains": {
                      "properties": {
                        "name": {
                          "const": "STAFF_CLIENT_SECRET_FILE"
                        },
                        "required_when": {
                          "const": "staff"
                        }
                      },
                      "required": [
                        "name",
                        "required_when"
                      ]
                    }
                  },
                  {
                    "contains": {
                      "properties": {
                        "name": {
                          "const": "SMTP_PASSWORD_FILE"
                        },
                        "required_when": {
                          "const": "smtp-auth"
                        }
                      },
                      "required": [
                        "name",
                        "required_when"
                      ]
                    }
                  }
                ]
              }
            },
            "required": [
              "staff_provider",
              "public_origin_env",
              "configuration",
              "secret_files",
              "host_setup"
            ]
          },
          "config": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "name": {
                      "const": "AUTH_BASE_URL"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "name": {
                      "const": "AUTH_SECRET_FILE"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "name": {
                      "const": "AUTH_DATABASE_URL"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "name": {
                      "const": "STAFF_PROVIDER"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              }
            ]
          },
          "postgres": {
            "required": [
              "sign_in"
            ],
            "properties": {
              "roles": {
                "required": [
                  "auth"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sign_in": {
            "properties": {
              "outsiders": {
                "const": "email-link"
              }
            },
            "required": [
              "outsiders"
            ]
          }
        },
        "required": [
          "sign_in"
        ]
      },
      "then": {
        "properties": {
          "sign_in": {
            "properties": {
              "configuration": {
                "required": [
                  "SMTP_HOST",
                  "SMTP_PORT",
                  "SMTP_FROM",
                  "SMTP_USER",
                  "SMTP_PASSWORD_FILE"
                ]
              }
            },
            "required": [
              "email_link"
            ]
          },
          "config": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "name": {
                      "const": "SMTP_HOST"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "name": {
                      "const": "SMTP_PORT"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "name": {
                      "const": "SMTP_FROM"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "name": {
                      "const": "SMTP_USER"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "name": {
                      "const": "SMTP_PASSWORD_FILE"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sign_in": {
            "properties": {
              "staff": {
                "type": "object"
              }
            },
            "required": [
              "staff"
            ]
          }
        },
        "required": [
          "sign_in"
        ]
      },
      "then": {
        "properties": {
          "sign_in": {
            "properties": {
              "configuration": {
                "required": [
                  "STAFF_ISSUER",
                  "STAFF_CLIENT_ID",
                  "STAFF_CLIENT_SECRET_FILE"
                ]
              }
            },
            "required": []
          },
          "config": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "name": {
                      "const": "STAFF_ISSUER"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "name": {
                      "const": "STAFF_CLIENT_ID"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "name": {
                      "const": "STAFF_CLIENT_SECRET_FILE"
                    }
                  },
                  "required": [
