{
  "name": "team-tool-postgres",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:worker",
    "start": "node --env-file-if-exists=.env --import ./scripts/startup.mjs node_modules/next/dist/bin/next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:coverage": "npm test -- --coverage",
    "test:e2e": "playwright test",
    "check": "sh scripts/check.sh",
    "db:bootstrap": "node --env-file-if-exists=.env scripts/bootstrap.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test:policy-fault": "node --env-file-if-exists=.env scripts/prove-policy.mjs",
    "check:sign-in-review": "node scripts/sign-in-review.mjs",
    "test:files": "node scripts/test-files.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "worker": "node --env-file-if-exists=.env dist/worker.mjs",
    "pretest": "npm run build:worker",
    "test:privilege-fault": "node --env-file-if-exists=.env scripts/prove-privileges.mjs",
    "predb:migrate": "npm run build:worker",
    "handover:check": "node scripts/handover.mjs check",
    "hosting:render": "node scripts/handover.mjs render",
    "handover:found": "node scripts/found-handover.mjs",
    "test:handover": "node --test tests/handover.test.mjs",
    "test:image": "sh scripts/docker-run.sh -- node scripts/test-image.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "better-auth": "1.7.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.0",
    "jose": "6.2.15",
    "kysely": "0.29.8",
    "lucide-react": "0.544.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.80.0",
    "server-only": "0.0.1",
    "shadcn": "4.22.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.3.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@azure/storage-blob": "12.29.1",
    "pg-boss": "12.38.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.5.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.36.0",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vitest": "5.0.5",
    "esbuild": "0.28.2",
    "ajv": "8.20.0",
    "smtp-server": "3.21.3"
  },
  "type": "module"
}
