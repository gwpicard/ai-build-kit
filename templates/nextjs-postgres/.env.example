# Example values for a disposable local database only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-admin-example
POSTGRES_DB=tool_test
POSTGRES_PORT=55432
ADMIN_DATABASE_URL=postgresql://postgres:local-admin-example@127.0.0.1:55432/tool_test
MIGRATION_DATABASE_URL=postgresql://tool_owner:local-owner-example@127.0.0.1:55432/tool_test
DATABASE_URL=postgresql://tool_app:local-app-example@127.0.0.1:55432/tool_test

# Sign-in uses its own restricted role, never the migration connection.
AUTH_DATABASE_URL=postgresql://tool_auth:local-auth-example@127.0.0.1:55432/tool_test
# HTTPS is required even during development. Supply secret file locations locally.
AUTH_BASE_URL=https://localhost:3443
AUTH_SECRET_FILE=
STAFF_PROVIDER=none
STAFF_ISSUER=
STAFF_CLIENT_ID=
STAFF_CLIENT_SECRET_FILE=
MICROSOFT_TENANT_ID=
GOOGLE_WORKSPACE_DOMAIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD_FILE=

# Run a worker, or set timer and supply a generated token of at least 32 characters.
JOBS_MODE=worker
JOBS_TIMER_TOKEN=

# Optional private file store. Supply credentials through the local environment or host.
