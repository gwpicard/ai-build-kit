# Example values for a disposable local database only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-admin-example
POSTGRES_DB=tool_test
POSTGRES_PORT=55432
ADMIN_DATABASE_URL=postgresql://postgres:local-admin-example@127.0.0.1:55432/tool_test
MIGRATION_DATABASE_URL=postgresql://tool_owner:local-owner-example@127.0.0.1:55432/tool_test
DATABASE_URL=postgresql://tool_app:local-app-example@127.0.0.1:55432/tool_test

# Run a worker, or set timer and supply a generated token of at least 32 characters.
JOBS_MODE=worker
JOBS_TIMER_TOKEN=

# Optional private file store. Supply credentials through the local environment or host.
# FILES_ADAPTER=s3
# FILES_LINK_SECONDS=60
# FILES_S3_BUCKET=
# FILES_S3_REGION=
# FILES_S3_ENDPOINT=
# FILES_S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# FILES_ADAPTER=azure-blob
# FILES_AZURE_ACCOUNT=
# FILES_AZURE_ACCOUNT_KEY=
# FILES_AZURE_CONTAINER=
# FILES_AZURE_ENDPOINT=

# Runtime metadata and local SMTP. Production SMTP requires TLS and credentials.
# NODE_ENV=development
PORT=3107
HOSTNAME=0.0.0.0
SOURCE_COMMIT=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=tool@example.test
AWS_SESSION_TOKEN=
FILES_ADAPTER=s3
FILES_S3_BUCKET=private-files
FILES_S3_REGION=local
FILES_S3_ENDPOINT=http://127.0.0.1:9000
FILES_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=local-example
AWS_SECRET_ACCESS_KEY=local-example
