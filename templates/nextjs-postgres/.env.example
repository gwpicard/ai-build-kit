# Example values for a disposable local database only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-admin-example
POSTGRES_DB=tool_test
POSTGRES_PORT=55432
ADMIN_DATABASE_URL=postgresql://postgres:local-admin-example@127.0.0.1:55432/tool_test
MIGRATION_DATABASE_URL=postgresql://tool_owner:local-owner-example@127.0.0.1:55432/tool_test
DATABASE_URL=postgresql://tool_app:local-app-example@127.0.0.1:55432/tool_test

# Run a worker, or set timer and supply a generated token of at least 32 characters.
JOBS_MODE=worker
JOBS_TIMER_TOKEN=
