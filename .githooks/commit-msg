#!/usr/bin/env sh
# commit-msg: take the AI attribution lines back out of a commit message.
#
# A coding agent appends two kinds of line to a message it writes: a co-author
# trailer naming the model, and a link back to the session that produced the
# work. The link is the one that matters. It is a personal address on the
# agent vendor's site, it is readable by anyone once this repository is public,
# and nothing in a commit message needs it.
#
# Every supported agent has a setting that turns both off, and those settings
# are the first line of defence. They are not the last one. A setting lives
# outside the repository, so it protects the machine it was set on and no
# other, and a session can be told to override it. This hook is inside the
# repository, applies to every commit whoever makes it, and cannot be argued
# with.
#
# It removes the attribution lines and leaves everything else alone, including
# prose about Claude, Cursor or Gemini. The kit is built with those tools and
# describes them constantly, so a hook that struck out the word would make the
# repository unable to talk about its own subject.
#
# Git runs a hook from the folder named by core.hooksPath, which is a local
# setting and is not carried by a clone. docs/MAINTAINING.md gives the one
# command that points a fresh clone here.
#
# awk rather than python3, because a hook that cannot run is a hook that lets
# the line through, and awk is present wherever git is.
set -eu

msg=$1

awk '
{ line[NR] = $0 }
END {
  kept = 0
  for (i = 1; i <= NR; i++) {
    low = tolower(line[i])
    if (low ~ /^[ \t]*co-authored-by:[ \t]*claude/) continue
    if (low ~ /^[ \t]*claude-session:/) continue
    if (low ~ /generated (with|by) \[claude code\]/) continue
    if (index(low, "claude.ai/code/session_")) continue
    if (index(low, "noreply@anthropic.com")) continue
    out[++kept] = line[i]
  }

  # Removing a trailer block strands what sat above it: the blank lines that
  # separated it, and the row of dashes a squash merge writes before it. Take
  # those off too, or every rewritten message ends in punctuation with nothing
  # after it.
  while (kept > 0) {
    tail = out[kept]
    gsub(/[ \t]/, "", tail)
    if (tail == "") { kept--; continue }
    if (tail ~ /^(-{3,}|_{3,}|\*{3,})$/) { kept--; break }
    break
  }

  blank = 0
  for (i = 1; i <= kept; i++) {
    body = out[i]
    gsub(/[ \t]/, "", body)
    if (body == "") {
      blank++
      if (blank > 1) continue
    } else {
      blank = 0
    }
    print out[i]
  }
}
' "$msg" > "$msg.scrubbed"

mv "$msg.scrubbed" "$msg"
